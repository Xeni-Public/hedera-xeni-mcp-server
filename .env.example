# Authored-by: Anand Palanisamy - anand@xeni.com

# hedera-xeni-mcp-server — environment configuration
#
# Copy to .env (or .env.<env> for per-env configs: .env.dev, .env.testnet-ci, .env.testnet-uat, .env.mainnet-prod).
# NEVER commit any .env file containing real keys or account IDs.
# See docs/DESIGN.md §3 (account model) + §7 (transports) + HCS topic model section for rationale.

# -----------------------------------------------------------------------------
# REQUIRED — Hedera accounts
# -----------------------------------------------------------------------------

# Platform admin. Pays HCS fees + runs topic ops.
HEDERA_OPERATOR_ID=0.0.xxxxxxx
HEDERA_OPERATOR_KEY=302e0201...ecdsa-private-key-hex...

# Autonomous booking spender. Signs approved transfers on User A's behalf and refunds within treasury's allowance.
HEDERA_AGENT_ID=0.0.xxxxxxx
HEDERA_AGENT_KEY=302e0201...ecdsa-private-key-hex...

# Xeni-MoR receiving + refunding account. Key is COLD — only used for initial + replenishment refund-allowance approvals.
# Never loaded into server process env in production. See docs/RUNBOOKS.md "Treasury replenishment" section.
HEDERA_XENI_TREASURY_ID=0.0.xxxxxxx

# -----------------------------------------------------------------------------
# REQUIRED — On-chain audit topic (created once per env via scripts/bootstrap-audit-topic.ts)
# -----------------------------------------------------------------------------

HEDERA_XENI_AUDIT_TOPIC_ID=0.0.xxxxxxx

# -----------------------------------------------------------------------------
# REQUIRED — Network selection
# -----------------------------------------------------------------------------

# "testnet" | "mainnet"
HEDERA_NETWORK=testnet

# -----------------------------------------------------------------------------
# OPTIONAL — Transport
# -----------------------------------------------------------------------------

# "stdio" (default — AgentService spawns as child process)
# "http"  (dev only — binds to HEDERA_HTTP_BIND, default 127.0.0.1; refused in NODE_ENV=production)
HEDERA_TRANSPORT=stdio

# HTTP binding (dev only). Loopback-only default. See docs/DESIGN.md Transports section for security rules.
HEDERA_HTTP_BIND=127.0.0.1
HEDERA_HTTP_PORT=7701

# -----------------------------------------------------------------------------
# OPTIONAL — Alerts
# -----------------------------------------------------------------------------

# Slack webhook for treasury allowance + outbox dead-letter alerts.
# Channels: #non-prod-oncall-fund-treasury (dev/qa/uat), #oncall-fund-treasury (prod). Workspace: xeniworkspace.slack.com.
SLACK_TREASURY_ALERT_WEBHOOK=https://hooks.slack.com/services/...

# -----------------------------------------------------------------------------
# OPTIONAL — Private plugin (fee calculator)
# -----------------------------------------------------------------------------

# Path to the private fee-calculator plugin. See docs/DESIGN.md Public/private boundary section.
# NODE_ENV=development: unset = fail-open to DefaultFeeCalculator
# NODE_ENV=production: required = fail-closed
HEDERA_XENI_PRIVATE_PLUGINS=

# Expected fee calculator impl name for startup health-check assertion (optional).
EXPECTED_FEE_CALCULATOR_IMPL=

# -----------------------------------------------------------------------------
# REFUND ALLOWANCE (rolling daily cap)
# -----------------------------------------------------------------------------

# HBAR-denominated daily cap. See docs/DESIGN.md Refund allowance strategy table.
HEDERA_REFUND_DAILY_CAP_HBAR=10000

# Alert threshold as fraction consumed (0.8 = alert at 80% consumed / 20% remaining).
HEDERA_REFUND_ALERT_THRESHOLD=0.8

# Daily cap reset timezone. Only the cutover boundary; persisted timestamps stay UTC.
HEDERA_REFUND_CUTOVER_TZ=America/Los_Angeles

# -----------------------------------------------------------------------------
# RUNTIME
# -----------------------------------------------------------------------------

# "development" | "test" | "production" (UAT + prod both use "production")
NODE_ENV=development

# Log level — debug | info | warn | error
LOG_LEVEL=info
