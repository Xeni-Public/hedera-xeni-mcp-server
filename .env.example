# Authored-by: Anand Palanisamy - anand@xeni.com

# hedera-xeni-mcp-server — environment configuration
#
# Copy to .env (or .env.<env> for per-env configs: .env.dev, .env.testnet-ci, .env.testnet-uat, .env.mainnet-prod).
# NEVER commit any .env file containing real keys or account IDs.
# See docs/DESIGN.md §3 (account model) and §8 (transport rules) for rationale.
#
# POST-PIVOT (2026-04-20) — the MCP server uses a SINGLE runtime identity (agent).
# Operator and treasury are COLD keys used only by standalone bootstrap scripts
# (and ops top-ups). They MUST NOT be loaded into the running server's env.
# Sections below are split accordingly; read section headers before copying values.

# =============================================================================
# SECTION A — REQUIRED AT RUNTIME (loaded by the MCP server on startup)
# =============================================================================

# ---- A.1 Agent account (sole runtime signer) ----
# Signs every runtime transaction: transfers via allowance, audit submits.
# The MCP's `loadAgentAccount()` reads these at startup.
HEDERA_AGENT_ID=0.0.xxxxxxx
HEDERA_AGENT_KEY=302e0201...ecdsa-private-key-hex...

# ---- A.2 Network + env label ----
# "testnet" | "mainnet"
HEDERA_NETWORK=testnet
# Env label for logs and alert payloads: dev | testnet-ci | testnet-uat | mainnet-prod
HEDERA_ENV_LABEL=dev

# ---- A.3 Global audit topic ID (created once per env by scripts/bootstrap-audit-topic.ts) ----
# Dual use:
#   1. Runtime: AgentService's outbox worker calls MCP.submit_message(this, payload).
#   2. Bootstrap idempotency: re-running `npm run bootstrap:audit-topic` with
#      this set makes M3 verify the topic's memo via Mirror Node rather than
#      create a new topic. Mirrors the M4 pattern for HEDERA_XENI_TREASURY_ID
#      (see A.4).
# Populated from the M3 run output at cutover time; paste the printed topic
# ID into the target env's .env file.
HEDERA_XENI_AUDIT_TOPIC_ID=0.0.xxxxxxx

# ---- A.4 Treasury account ID (read-only runtime use) ----
# Public account identifier — NOT a private key. Safe in runtime env.
# Used by the `get_treasury_allowance_remaining` MCP read tool (and future
# Xeni read tools) to query Mirror Node for the treasury→agent allowance.
# The matching private KEY (HEDERA_XENI_TREASURY_KEY) stays COLD in
# section B.2 — it never appears in the server's runtime env.
# See docs/DESIGN.md §3 for the ID-vs-KEY distinction.
HEDERA_XENI_TREASURY_ID=0.0.xxxxxxx

# ---- A.5 External service URLs (REQUIRED for both runtime + bootstrap) ----
# These are REQUIRED in every env (dev, testnet-ci, testnet-uat, mainnet-prod).
# There is NO hardcoded default anywhere in the code — if either is missing
# or empty, the server + every bootstrap script refuses to start, with a
# clear message naming the missing variable. See docs/DESIGN.md §3
# "External URLs — required env, fail-fast" for the rationale (prevents
# silent dev-vs-prod misconfig).
#
# Mirror Node REST API root. Canonical public endpoints:
#   testnet:  https://testnet.mirrornode.hedera.com
#   mainnet:  https://mainnet-public.mirrornode.hedera.com
# Internal / private mirrors can be substituted here without code change
# (e.g. a Cloudflare-cached endpoint or an AWS-internal mirror).
HEDERA_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com
#
# HashScan explorer root. Used for runbook log hints after bootstrap
# (e.g. the M4 treasury-idempotent re-use path prints a HashScan link
# for ops to verify the treasury account). Canonical public endpoint:
#   https://hashscan.io
# Private / vanity explorer hosts can be substituted here.
HEDERA_HASHSCAN_BASE_URL=https://hashscan.io

# =============================================================================
# SECTION B — REQUIRED ONLY FOR BOOTSTRAP SCRIPTS (ops-laptop, DO NOT set in the server's env)
# =============================================================================
#
# These are loaded by `scripts/bootstrap-*.ts` when Anand runs them manually
# from an ops laptop. DO NOT populate them in the running server's .env —
# the server WARN-logs on startup if it sees them (cold-key invariant, see
# docs/DESIGN.md §3).
#
# For bootstrap runs, create a separate `.env.bootstrap.<env>` file that's
# used only when invoking `npm run bootstrap:audit-topic` or
# `npm run bootstrap:treasury`.

# ---- B.1 Operator account (platform admin; bootstrap + emergencies only) ----
HEDERA_OPERATOR_ID=0.0.xxxxxxx
HEDERA_OPERATOR_KEY=302e0201...ecdsa-private-key-hex...

# ---- B.2 Treasury account KEY (Xeni-MoR receiver; cold, signs allowance grants only) ----
# The treasury ACCOUNT ID (HEDERA_XENI_TREASURY_ID) lives in section A.4
# because the public identifier is safe at runtime. Only the PRIVATE KEY
# is cold — held on ops laptop / HSM / hardware wallet, NEVER in server env.
# Printed ONCE by `npm run bootstrap:treasury` (M4). Ops captures it into
# offline storage at that moment and never again.
HEDERA_XENI_TREASURY_KEY=302e0201...ecdsa-private-key-hex...

# ---- B.3 Optional M4 bootstrap tuning (used ONLY by `npm run bootstrap:treasury`) ----
# Initial balance loaded into the newly-created treasury account (HBAR).
# Default 30000 — 3x the default allowance for tx-fee buffer + daily-cap
# replenishment headroom. Increase for higher-volume envs before running.
# HEDERA_XENI_TREASURY_INITIAL_BALANCE_HBAR=30000
#
# Initial refund allowance granted to agent at bootstrap time (HBAR).
# Default 10000 — matches DESIGN.md §4 daily cap example. Must be ≤ initial
# balance (script warns if not; Hedera allows allowance > balance but the
# agent can't spend beyond what the treasury actually holds).
# HEDERA_XENI_TREASURY_INITIAL_ALLOWANCE_HBAR=10000

# =============================================================================
# SECTION C — OPTIONAL RUNTIME (MCP server, nice-to-have)
# =============================================================================

# ---- C.1 Transport ----
# "stdio" (default — AgentService spawns as child process)
# "http"  (dev only — binds to HEDERA_HTTP_BIND, default 127.0.0.1; refused in NODE_ENV=production)
HEDERA_TRANSPORT=stdio

# HTTP binding (dev only). Loopback-only default. See docs/DESIGN.md §8.
HEDERA_HTTP_BIND=127.0.0.1
# Set to 0 ONLY for integration tests (OS assigns a free port) — with port 0
# the server starts but you won't know where to curl it. Use the real port
# (7701) for dev debugging.
HEDERA_HTTP_PORT=7701

# ---- C.2 Runtime mode ----
# "development" | "test" | "production" (UAT + prod both use "production")
NODE_ENV=development

# Log level — debug | info | warn | error
LOG_LEVEL=info

# =============================================================================
# SECTION D — MOVED TO AgentService (post-pivot)
# =============================================================================
#
# Previously lived here; now owned by AgentService Go-side. Listed for
# discoverability / grep; do not set on MCP side.
#
# - SLACK_TREASURY_ALERT_WEBHOOK         (AgentService's treasury allowance + outbox dead-letter alerts)
# - HEDERA_REFUND_DAILY_CAP_HBAR         (AgentService's treasuryAllowanceGuard)
# - HEDERA_REFUND_ALERT_THRESHOLD        (AgentService's treasuryAllowanceGuard)
# - HEDERA_REFUND_CUTOVER_TZ             (AgentService's daily cap reset scheduler)
# - HEDERA_XENI_PRIVATE_PLUGINS          (AgentService-private fee calculator loader — not on MCP anymore)
# - EXPECTED_FEE_CALCULATOR_IMPL         (AgentService-side startup assertion)
#
# See docs/HANDOVER_TO_AGENT_SERVICE.md for the Go-port specs.
