# Authored-by: Anand Palanisamy - anand@xeni.com
#
# legacy-peer-deps=true
# ---------------------
# Upstream @hiero-ledger/sdk@2.81.0 pulls protobufjs@8.0.0, but its transitive
# dep @hiero-ledger/proto@2.26.0-beta.3 declares a strict peer of
# protobufjs@"7.5.4". npm v7+ with default `strict-peer-deps` rejects this
# via `npm ci`. We're not in a position to patch upstream; we accept the
# install tree npm resolves when warnings are overridden.
#
# Safer than --force and scoped to this repo (not global). Applies to both
# `npm install` and `npm ci`.
legacy-peer-deps=true
